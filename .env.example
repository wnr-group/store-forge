# Copy to .env.local (never commit .env.local) and fill in from your Supabase project.

# --- Supabase Auth (Project Settings -> API) --------------------------------
# Public: safe for the browser. Used for sign-in and to build public product-image URLs
# (bucket `products`, created by migration 0006).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Application ------------------------------------------------------------
# Origin of this app, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Root domain for tenant subdomains: https://<store-slug>.<root> serves that store's public storefront.
# Local: lvh.me:3000 (lvh.me and *.lvh.me resolve to 127.0.0.1, no hosts-file edits). Production: store-forge.com
# (no port, no scheme) with a wildcard DNS record *.store-forge.com and the domain added to the Vercel project.
# Leave empty to disable subdomain routing. The main app, /login and /admin always stay on the root domain.
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3000

# --- Supabase Admin Auth (SERVER ONLY - never prefix with NEXT_PUBLIC_) ---------
# Project Settings -> API -> service_role key. Read in exactly one module (lib/supabase/admin.ts) and
# used ONLY for the Admin Auth API: creating/confirming provisioned users, admin-assisted password
# resets and compensating deletes. It bypasses RLS, so it is never used for database queries.
# Set it in Vercel as a server-side Environment Variable; never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- PostgreSQL / Drizzle (SERVER ONLY - never prefix with NEXT_PUBLIC_) ------
# Application queries. Connect through the Supabase TRANSACTION-mode pooler
# (Dashboard -> Connect -> Transaction pooler, port 6543) as the dedicated
# `storeforge_app` role (NOT postgres - that role bypasses row level security;
# the app refuses to start with it). Pooler usernames are "<role>.<project-ref>":
#   postgresql://storeforge_app.<project-ref>:<APP_ROLE_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Set the role's password yourself - see README ("Create the application role").
DATABASE_URL=

# Migrations only (`npm run db:migrate`). Privileged `postgres` owner role over a
# direct connection (db.<ref>.supabase.co:5432) or the SESSION-mode pooler
# (port 5432) if you need IPv4. Never used by the running application.
#   postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=
