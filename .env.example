# Copy to .env.local (never commit .env.local) and fill in from your Supabase project.

# --- Supabase Auth (Project Settings -> API) --------------------------------
# Public: safe for the browser. Used for sign-in and to build public product-image URLs
# (bucket `products`, created by migration 0006).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Application ------------------------------------------------------------
# Origin of this app, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Root domain for tenant subdomains: https://<store-slug>.<root> serves that store's public storefront.
# Local: lvh.me:3000 (lvh.me and *.lvh.me resolve to 127.0.0.1, no hosts-file edits). Production: store-forge.com
# (no port, no scheme) with a wildcard DNS record *.store-forge.com and the domain added to the Vercel project.
# Leave empty to disable subdomain routing. The main app, /login and /admin always stay on the root domain.
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3000

# --- StoreForge API (NestJS) (SERVER ONLY) ------------------------------------------------------------------
# REQUIRED for every business operation (catalog, customers, orders data, team, settings, dashboard, platform admin, public
# storefront): all of them go through this API, which owns the business logic, authorization, tenant isolation and database
# access. There is no direct-database alternative and no per-module switch. The browser never calls the API: the access
# token stays in the HttpOnly cookie and is attached by this server.
# Sign-in, sign-out, token refresh, password change and session checks use the same API (it talks to Supabase Auth itself).
API_BASE_URL=http://localhost:4000/api/v1
# Shared secret (32+ characters), the SAME value as AUTH_BFF_SECRET in the API. It proves the call comes from this
# server, which lets the API use the visitor's real address for login rate limiting. Never NEXT_PUBLIC_.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_BFF_SECRET=
