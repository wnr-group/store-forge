# Copy to .env.local (never commit .env.local) and fill in from your Supabase project.

# --- Supabase Auth (Project Settings -> API) --------------------------------
# Public: safe for the browser. Used for authentication and to build public product-image URLs
# (bucket `products`, created by migration 0006). No service-role key is used anywhere.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Application ------------------------------------------------------------
# Origin of this app, no trailing slash. Used for email links (verify / reset).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- PostgreSQL / Drizzle (SERVER ONLY - never prefix with NEXT_PUBLIC_) ------
# Application queries. Connect through the Supabase TRANSACTION-mode pooler
# (Dashboard -> Connect -> Transaction pooler, port 6543) as the dedicated
# `storeforge_app` role (NOT postgres - that role bypasses row level security;
# the app refuses to start with it). Pooler usernames are "<role>.<project-ref>":
#   postgresql://storeforge_app.<project-ref>:<APP_ROLE_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Set the role's password yourself - see README ("Create the application role").
DATABASE_URL=

# Migrations only (`npm run db:migrate`). Privileged `postgres` owner role over a
# direct connection (db.<ref>.supabase.co:5432) or the SESSION-mode pooler
# (port 5432) if you need IPv4. Never used by the running application.
#   postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=
